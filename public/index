const PR=['Цифровое государство','ИИ и технологии','Умные города','Чистая энергия и экология','Образование','Экономика и профессии'];
const RG='Астана,Алматы,Шымкент,Абай,Акмолинская область,Актюбинская область,Алматинская область,Атырауская область,Восточно-Казахстанская область,Жамбылская область,Жетісу,Западно-Казахстанская область,Карагандинская область,Костанайская область,Кызылординская область,Мангистауская область,Павлодарская область,Северо-Казахстанская область,Туркестанская область,Ұлытау'.split(',');
$('#rg').innerHTML='<option value="">Выбери регион</option>'+RG.map(x=>'<option>'+x+'</option>').join('');
$('#tiles').innerHTML=PR.map((p,i)=>'<label class="tile"><input type="radio" name="pr" value="'+i+'" required><span>'+p+'</span></label>').join('');
$('#dg').oninput=()=>$('#dv').textContent=$('#dg').value+'%';
const KEY='dk2050_v2';
let online=false,loc=[],V=[];
try{loc=JSON.parse(localStorage.getItem(KEY))||[]}catch(e){}
V=loc;
function show(){
 $('#st').textContent=online?'Общий опрос: ответы всех участников собираются в одной базе.':'Нет связи с сервером: ответы сохраняются только на этом устройстве.';
 const A=V.filter(v=>v&&v.p>=0&&v.p<PR.length),n=A.length;
 $('#cnt').textContent=n;
 const av=n?Math.round(A.reduce((s,v)=>s+Math.min(100,Math.max(0,+v.d||0)),0)/n):0;
 $('#avgt').textContent=n?av+'%':'—';$('#avg').style.width=av+'%';
 const r=$('#res');r.textContent='';
 PR.forEach((p,i)=>{const c=A.filter(v=>v.p===i).length,pc=n?Math.round(c*100/n):0;
  const d=document.createElement('div');d.innerHTML='<div class="rl"><span></span><b>'+c+'</b></div><div class="bar"><i style="width:'+pc+'%"></i></div>';
  d.querySelector('span').textContent=p;r.append(d)});
 const el=$('#ideas');el.textContent='';
 if(!n){el.innerHTML='<p class="mut" style="margin-top:16px">Пока нет ответов. Стань первым участником!</p>';return}
 const li=A.filter(v=>v.i).sort((a,b)=>b.t-a.t).slice(0,6);
 if(li.length){const t=document.createElement('p');t.style.cssText='margin:18px 0 0;font-weight:800;font-size:.85rem';t.textContent='Свежие идеи';const u=document.createElement('ul');
  li.forEach(v=>{const x=document.createElement('li');x.textContent='«'+String(v.i).slice(0,200)+'» — '+String(v.r||'').slice(0,40);u.append(x)});el.append(t,u)}}
const CID=(()=>{try{let c=localStorage.getItem('dk2050_cid');if(!c){c=crypto.randomUUID?crypto.randomUUID():String(Date.now())+Math.random().toString(36).slice(2);localStorage.setItem('dk2050_cid',c)}return c}catch(e){return 'x'+Date.now()+Math.random().toString(36).slice(2)}})();
async function load(){try{const r=await fetch('/api/votes',{cache:'no-store'});if(!r.ok)throw 0;V=await r.json();online=true}catch(e){online=false;V=loc}show()}
$('#f').addEventListener('submit',async e=>{e.preventDefault();const m=$('#msg');
 const v={p:+new FormData(e.target).get('pr'),d:+$('#dg').value,r:$('#rg').value,i:$('#idea').value.trim().slice(0,200)};
 try{
  const r=await fetch('/api/votes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...v,cid:CID})});
  if(r.status===429){m.textContent='Слишком много отправок. Подожди минуту и попробуй снова.';return}
  if(!r.ok)throw 0;
  m.textContent='Спасибо! Твой ответ учтён. Отправь форму снова, чтобы изменить его.';await load()
 }catch(x){
  loc=[{...v,t:Date.now()}];try{localStorage.setItem(KEY,JSON.stringify(loc))}catch(y){}
  V=loc;online=false;m.textContent='Нет связи с сервером. Ответ сохранён на этом устройстве.';show()}});
load();setInterval(()=>{if(!document.hidden)load()},20000);
</script>
